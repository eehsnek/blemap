# Server
PORT=4000
NODE_ENV=development

# Supabase (optional — without these, the API uses in-memory demo data)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: Dashboard → Account → Access Tokens (enables `npm run configure:auth` Management API)
# SUPABASE_ACCESS_TOKEN=

# MiniLM embeddings (default: in-process @xenova/transformers)
# Optional FastAPI service (Python 3.10–3.12): npm run embed:serve
# EMBEDDING_URL=http://127.0.0.1:8000
# EMBEDDING_PREFER_HTTP=1
# EMBEDDING_THRESHOLD=0.65
# EMBEDDING_MERGE_THRESHOLD=0.65
# EMBEDDING_SUGGEST_THRESHOLD=0.5
# EMBEDDING_DISABLED=1
# EMBEDDING_LOCAL=0
# AI & Reddit (automation)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
CONFIRMATIONS_REQUIRED=5
REDDIT_SUBREDDITS=mildlyinfuriating,legaladvice,personalfinance
# pending (default) = scraped cases await community confirmation before matrix
# auto = publish valid scrapes immediately (demo opt-in only)
SCRAPE_PUBLISH_MODE=pending
# Local-only: allow requireAuth without JWT when Supabase Auth is unset (never in production)
# BLEMAP_DEV_AUTH=1
# Comma-separated auth user UUIDs treated as admin (bootstrap / memory store). Prefer DB role.
# BLEMAP_ADMIN_USER_IDS=
# Local demo Steward one-click login (disabled in production / when BLEMAP_DEMO_STEWARD=0)
# BLEMAP_DEMO_STEWARD=1
# BLEMAP_DEMO_STEWARD_EMAIL=steward.demo@blemap.local
# BLEMAP_DEMO_STEWARD_PASSWORD=BleMap-Steward-Demo-2026!

# Reject irrelevant solutions on submit (default advisory-only via /solve/analyze)
SOLVE_AI_ENFORCE=false

# High-gap toast threshold for Prospector (frontend)
NOTIFY_HIGH_GAP_THRESHOLD=70

# Scrape sources (comma-separated). Default: hackernews only; adds reddit if OAuth creds set
# SCRAPE_SOURCES=hackernews
# HN_FEEDS=askstories,newstories
# HN_REQUEST_DELAY_MS=50

# Secures POST /api/scrape/run (Vercel Cron sends Bearer CRON_SECRET when set)
CRON_SECRET=

# Reddit API (required for reliable scraping — anonymous JSON often returns 403)
# Create app: https://www.reddit.com/prefs/apps
# - "web app" → client_credentials only
# - "script" → also set REDDIT_USERNAME + REDDIT_PASSWORD (your Reddit account)
# REDDIT_CLIENT_ID=your_client_id
# REDDIT_CLIENT_SECRET=your_client_secret
# REDDIT_USERNAME=
# REDDIT_PASSWORD=
# REDDIT_USER_AGENT=web:BleMap:v1.0.0 (by /u/YourRedditUsername)
# REDDIT_REQUEST_DELAY_MS=1100
