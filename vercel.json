{
  "version": 2,
  "builds": [{ "src": "api/index.js", "use": "@vercel/node" }],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/config.js", "dest": "/api/index.js" },
    { "src": "/health", "dest": "/api/index.js" },
    { "src": "/frontend/(.*)", "dest": "/api/index.js" },
    { "src": "/", "dest": "/api/index.js" }
  ],
  "crons": [
    {
      "path": "/api/scrape/run",
      "schedule": "0 */6 * * *"
    }
  ]
}
