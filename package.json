{
  "name": "blemap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/free-port.js 4000",
    "dev": "node --watch backend/server.js",
    "start": "node scripts/free-port.js 4000 && node backend/server.js",
    "test": "node --test tests/*.test.js",
    "scrape": "node scripts/run-scrape.js",
    "configure:auth": "node scripts/configure-supabase-dev-auth.mjs",
    "smoke": "node scripts/smoke-go-live.mjs",
    "embed:serve": "cd services/embedding && .venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000",
    "embed:rebuild": "node scripts/rebuild-embeddings.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  }
}
